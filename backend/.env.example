# Copy to .env for an existing PostgreSQL database, OR run npm run db:local
# to create an isolated, password-protected local project database automatically.
DATABASE_URL=postgresql://clinic_user:REPLACE_ME@127.0.0.1:5432/dental_clinic
TEST_DATABASE_URL=postgresql://clinic_user:REPLACE_ME@127.0.0.1:5432/dental_clinic_test
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=true
# PG_BIN is only needed for db:local if pg_config is unavailable.
# PG_BIN=C:/Program Files/PostgreSQL/17/bin
