{
  "name": "dental-clinic-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:local": "node db/scripts/local-postgres.js start",
    "db:local:stop": "node db/scripts/local-postgres.js stop",
    "db:migrate": "node db/scripts/migrate.js",
    "db:seed": "node db/seeds/seed.js",
    "db:verify": "node db/scripts/verify.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "globals": "17.14.0",
    "supertest": "7.3.2",
    "vitest": "5.1.2"
  }
}
